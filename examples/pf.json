{
  "pf": {
    "settings": [
      {
        "computation-label": [
          "nucleation"
        ],
        "physical-phenomenon": [
          "Homogeneous nucleation (single seed)"
        ],
        "problem-specification": {
          "governing-equation": [
            {
              "type": [
                "AC"
              ],
              "evolved-variable": "phi",
              "free-energy-density-term": [
                "f_total"
              ]
            }
          ],
          "free-energy-density": [
            {
              "name": "f_total",
              "contribution": [
                "Interfacial",
                "Chemical"
              ],
              "description": "Non-dimensionalized Ginzburg-Landau",
              "expression": "0.5 * (nabla phi)^2 + g(phi) - delta_f * p(phi)",
              "unit": "dimensionless"
            }
          ]
        },
        "domain": {
          "dimensionality": "2D",
          "coordinate-system": "Cartesian",
          "domain-size": {
            "value": [
              100.0,
              100.0
            ],
            "unit": "dimensionless"
          },
          "boundary-conditions": [
            {
              "type": "Periodic"
            }
          ],
          "initial-conditions": [
            "phi(r) = 0.5 * [1 - tanh((r - r_0) / sqrt(2))] where r = sqrt(x^2 + y^2)"
          ]
        },
        "numerical-method": [
          {
            "spatial-discretization": "FVM",
            "spatial-accuracy-order": 2,
            "mesh-type": "Regular",
            "temporal-discretization": "Backward Euler",
            "temporal-accuracy-order": 1,
            "grid-spacing": [
              {
                "name": "dx",
                "value": 0.4,
                "unit": "dimensionless"
              },
              {
                "name": "dy",
                "value": 0.4,
                "unit": "dimensionless"
              }
            ],
            "time-step-size": [
              {
                "name": "dt",
                "value": 0.01,
                "unit": "dimensionless"
              }
            ],
            "solver": [
              "Picard",
              "FiPy Default Linear Solver"
            ]
          }
        ],
        "variables": {
          "model-parameter": [
            {
              "name": "delta_f",
              "value": 0.04714045,
              "type": "float",
              "unit": "dimensionless",
              "description": "Non-dimensional nucleation driving force (sqrt(2)/30)"
            },
            {
              "name": "r_0",
              "value": 5.05,
              "type": "float",
              "unit": "dimensionless",
              "description": "Initial diffuse seed radius (e.g., 1.01 * r* for supercritical run)"
            }
          ],
          "field-variable": [
            {
              "name": "phi",
              "type": "Scalar",
              "unit": "dimensionless",
              "description": "Non-conserved phase field variable (0=liquid, 1=solid)"
            }
          ]
        }
      }
    ]
  }
}
